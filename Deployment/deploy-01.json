{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "CloudLabs template for WRK560: lab VM, Fabric capacity, ADLS Gen2 with Litware data, Microsoft Foundry project with a model deployment, and (optionally) Azure Databricks with a Unity Catalog catalog."
  },
  "parameters": {
    "adminUsername": {
      "type": "string",
      "defaultValue": "demouser"
    },
    "adminPassword": {
      "type": "securestring"
    },
    "trainerUserName": {
      "type": "string",
      "defaultValue": "trainer"
    },
    "trainerUserPassword": {
      "type": "securestring"
    },
    "AzureUserName": {
      "type": "string",
      "metadata": { "description": "Lab user UPN. CloudLabs value: GET-AZUSER-UPN" }
    },
    "AzurePassword": {
      "type": "securestring",
      "metadata": { "description": "Lab user password or Temporary Access Pass. CloudLabs value: GET-AZUSER-PASSWORD" }
    },
    "AzureUserObjectId": {
      "type": "string",
      "metadata": { "description": "Lab user object ID. CloudLabs value: GET-AZUSER-OBJECTID" }
    },
    "DeploymentID": {
      "type": "string",
      "metadata": { "description": "CloudLabs value: GET-DEPLOYMENT-ID" }
    },
    "validationSpObjectId": {
      "type": "string",
      "defaultValue": "",
      "metadata": { "description": "Object ID of the service principal the Foundry and Databricks validators sign in with. CloudLabs value: GET-SERVICEPRINCIPAL-SPOBJECT-ID. Leave empty to skip." }
    },
    "deployDatabricks": {
      "type": "bool",
      "defaultValue": true,
      "metadata": { "description": "true for the full lab (Exercise 04: Azure Databricks and mirroring), false for the Fabric-only variant." }
    },
    "scriptBaseUrl": {
      "type": "string",
      "metadata": { "description": "Public folder URL that hosts psscript.ps1, databricks-setup.ps1, and dlt-notebook.py, ending with a slash." }
    },
    "labDataZipUrl": {
      "type": "string",
      "defaultValue": "",
      "metadata": { "description": "Public or SAS URL of litwaredata.zip (the eight lab CSV files). Leave empty to skip data seeding." }
    },
    "vmSize": {
      "type": "string",
      "defaultValue": "Standard_D2s_v5"
    },
    "fabricCapacitySku": {
      "type": "string",
      "defaultValue": "F8",
      "allowedValues": [ "F2", "F4", "F8", "F16", "F32", "F64" ],
      "metadata": { "description": "Copilot and data agents need F2 or larger. F8 leaves headroom for Spark and Copilot in a 75-minute lab." }
    },
    "fabricLocation": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "foundryLocation": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "modelName": {
      "type": "string",
      "defaultValue": "gpt-5.1"
    },
    "modelVersion": {
      "type": "string",
      "defaultValue": "2025-11-13"
    },
    "modelDeploymentName": {
      "type": "string",
      "defaultValue": "gpt-5.1"
    },
    "modelSkuName": {
      "type": "string",
      "defaultValue": "GlobalStandard"
    },
    "modelCapacity": {
      "type": "int",
      "defaultValue": 50,
      "metadata": { "description": "Thousands of tokens per minute for the model deployment." }
    },
    "baseTime": {
      "type": "string",
      "defaultValue": "[utcNow('u')]",
      "metadata": { "description": "Do not set. Used to compute the data-seeding SAS expiry." }
    }
  },
  "variables": {
    "suffix": "[toLower(parameters('DeploymentID'))]",
    "location": "[resourceGroup().location]",
    "AzureSubscriptionID": "[subscription().subscriptionId]",
    "AzureTenantID": "[subscription().tenantId]",
    "vmName": "[concat('labvm-', variables('suffix'))]",
    "vmComputerName": "[take(variables('vmName'), 15)]",
    "virtualNetworkName": "vnet-lab",
    "subnetName": "default",
    "networkSecurityGroupName": "[concat(variables('vmName'), '-nsg')]",
    "networkInterfaceName": "[concat(variables('vmName'), '-nic')]",
    "publicIpAddressName": "[concat(variables('vmName'), '-pip')]",
    "publicIpDnsLabel": "[concat('labvm', uniqueString(resourceGroup().id))]",
    "storageAccountName": "[take(concat('stbuild', variables('suffix')), 24)]",
    "dataContainerName": "data",
    "unityContainerName": "unity",
    "capacityName": "[take(concat('fabric', replace(variables('suffix'), '-', '')), 63)]",
    "workspaceName": "[concat('ZavaWorkspace_', parameters('DeploymentID'))]",
    "foundryName": "[concat('foundry-', variables('suffix'))]",
    "projectName": "[concat('foundry-project-', variables('suffix'))]",
    "databricksName": "[concat('databricks-', variables('suffix'))]",
    "databricksManagedRg": "[concat(variables('databricksName'), '-managed-', uniqueString(resourceGroup().id))]",
    "accessConnectorName": "[concat('databricks-ac-', variables('suffix'))]",
    "catalogName": "[concat('litware_uc_', replace(variables('suffix'), '-', '_'))]",
    "cloudlabsFunctionsUri": "https://experienceazure.blob.core.windows.net/templates/cloudlabs-common/cloudlabs-windows-functions.ps1",
    "roles": {
      "azureAIUser": "53ca6127-db72-4b80-b1b0-d745d6d5456d",
      "contributor": "b24988ac-6180-42a0-ab88-20f7382dd24c",
      "storageBlobDataContributor": "ba92f5b4-2d11-453d-a403-e96b0029c9fe",
      "storageBlobDataReader": "2a2b9908-6ea1-4ae2-8e65-a410df84e7d1"
    },
    "cloudlabsCommon": "[concat(' -AzureUserName ', parameters('AzureUserName'), ' -AzurePassword ', parameters('AzurePassword'), ' -AzureTenantID ', variables('AzureTenantID'), ' -AzureSubscriptionID ', variables('AzureSubscriptionID'), ' -DeploymentID ', parameters('DeploymentID'), ' -adminUsername ', parameters('adminUsername'), ' -adminPassword ', parameters('adminPassword'), ' -trainerUserName ', parameters('trainerUserName'), ' -trainerUserPassword ', parameters('trainerUserPassword'))]",
    "dataSasProperties": {
      "signedServices": "b",
      "signedPermission": "rwlac",
      "signedResourceTypes": "sco",
      "signedProtocol": "https",
      "signedExpiry": "[dateTimeAdd(parameters('baseTime'), 'PT8H', 'yyyy-MM-ddTHH:mm:ssZ')]"
    }
  },
  "resources": [
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2024-05-01",
      "name": "[variables('networkSecurityGroupName')]",
      "location": "[variables('location')]",
      "properties": {
        "securityRules": [
          {
            "name": "allow-rdp",
            "properties": {
              "priority": 300,
              "protocol": "Tcp",
              "access": "Allow",
              "direction": "Inbound",
              "sourceAddressPrefix": "*",
              "sourcePortRange": "*",
              "destinationAddressPrefix": "*",
              "destinationPortRange": "3389"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2024-05-01",
      "name": "[variables('virtualNetworkName')]",
      "location": "[variables('location')]",
      "properties": {
        "addressSpace": { "addressPrefixes": [ "10.0.0.0/16" ] },
        "subnets": [
          {
            "name": "[variables('subnetName')]",
            "properties": { "addressPrefix": "10.0.0.0/24" }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2024-05-01",
      "name": "[variables('publicIpAddressName')]",
      "location": "[variables('location')]",
      "sku": { "name": "Standard" },
      "properties": {
        "publicIPAllocationMethod": "Static",
        "dnsSettings": { "domainNameLabel": "[variables('publicIpDnsLabel')]" }
      }
    },
    {
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2024-05-01",
      "name": "[variables('networkInterfaceName')]",
      "location": "[variables('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', variables('virtualNetworkName'))]",
        "[resourceId('Microsoft.Network/publicIPAddresses', variables('publicIpAddressName'))]",
        "[resourceId('Microsoft.Network/networkSecurityGroups', variables('networkSecurityGroupName'))]"
      ],
      "properties": {
        "ipConfigurations": [
          {
            "name": "ipconfig1",
            "properties": {
              "privateIPAllocationMethod": "Dynamic",
              "subnet": { "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('virtualNetworkName'), variables('subnetName'))]" },
              "publicIPAddress": { "id": "[resourceId('Microsoft.Network/publicIPAddresses', variables('publicIpAddressName'))]" }
            }
          }
        ],
        "networkSecurityGroup": { "id": "[resourceId('Microsoft.Network/networkSecurityGroups', variables('networkSecurityGroupName'))]" }
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2024-07-01",
      "name": "[variables('vmName')]",
      "location": "[variables('location')]",
      "identity": { "type": "SystemAssigned" },
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkInterfaces', variables('networkInterfaceName'))]"
      ],
      "properties": {
        "hardwareProfile": { "vmSize": "[parameters('vmSize')]" },
        "osProfile": {
          "computerName": "[variables('vmComputerName')]",
          "adminUsername": "[parameters('adminUsername')]",
          "adminPassword": "[parameters('adminPassword')]",
          "windowsConfiguration": { "provisionVMAgent": true }
        },
        "storageProfile": {
          "imageReference": {
            "publisher": "MicrosoftWindowsServer",
            "offer": "WindowsServer",
            "sku": "2022-datacenter-azure-edition",
            "version": "latest"
          },
          "osDisk": {
            "name": "[concat(variables('vmName'), '-osdisk')]",
            "createOption": "FromImage",
            "managedDisk": { "storageAccountType": "StandardSSD_LRS" }
          }
        },
        "networkProfile": {
          "networkInterfaces": [
            { "id": "[resourceId('Microsoft.Network/networkInterfaces', variables('networkInterfaceName'))]" }
          ]
        },
        "securityProfile": {
          "securityType": "TrustedLaunch",
          "uefiSettings": { "secureBootEnabled": true, "vTpmEnabled": true }
        },
        "diagnosticsProfile": { "bootDiagnostics": { "enabled": true } }
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines/extensions",
      "apiVersion": "2024-07-01",
      "name": "[concat(variables('vmName'), '/labvm-setup')]",
      "location": "[variables('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Compute/virtualMachines', variables('vmName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices/containers', variables('storageAccountName'), 'default', variables('dataContainerName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices/containers', variables('storageAccountName'), 'default', variables('unityContainerName'))]",
        "[resourceId('Microsoft.Databricks/workspaces', variables('databricksName'))]",
        "[extensionResourceId(resourceId('Microsoft.Databricks/workspaces', variables('databricksName')), 'Microsoft.Authorization/roleAssignments', guid(resourceId('Microsoft.Databricks/workspaces', variables('databricksName')), variables('vmName'), variables('roles').contributor))]",
        "[extensionResourceId(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), 'Microsoft.Authorization/roleAssignments', guid(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), variables('accessConnectorName'), variables('roles').storageBlobDataContributor))]"
      ],
      "properties": {
        "publisher": "Microsoft.Compute",
        "type": "CustomScriptExtension",
        "typeHandlerVersion": "1.10",
        "autoUpgradeMinorVersion": true,
        "settings": {
          "fileUris": [
            "[variables('cloudlabsFunctionsUri')]",
            "[concat(parameters('scriptBaseUrl'), 'psscript.ps1')]",
            "[concat(parameters('scriptBaseUrl'), 'databricks-setup.ps1')]",
            "[concat(parameters('scriptBaseUrl'), 'dlt-notebook.py')]"
          ]
        },
        "protectedSettings": {
          "commandToExecute": "[concat('powershell.exe -ExecutionPolicy Unrestricted -File psscript.ps1', variables('cloudlabsCommon'), ' -StorageAccountName ', variables('storageAccountName'), ' -DataContainerName ', variables('dataContainerName'), ' -DataSasB64 ', base64(listAccountSas(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), '2023-05-01', variables('dataSasProperties')).accountSasToken), ' -LabDataZipUrl \"', parameters('labDataZipUrl'), '\"', ' -DatabricksWorkspaceUrl \"', if(parameters('deployDatabricks'), concat('https://', reference(resourceId('Microsoft.Databricks/workspaces', variables('databricksName')), '2024-05-01').workspaceUrl), ''), '\"', ' -DatabricksWorkspaceResourceId \"', if(parameters('deployDatabricks'), resourceId('Microsoft.Databricks/workspaces', variables('databricksName')), ''), '\"', ' -DatabricksWorkspaceId \"', if(parameters('deployDatabricks'), reference(resourceId('Microsoft.Databricks/workspaces', variables('databricksName')), '2024-05-01').workspaceId, ''), '\"', ' -AccessConnectorId \"', if(parameters('deployDatabricks'), resourceId('Microsoft.Databricks/accessConnectors', variables('accessConnectorName')), ''), '\"', ' -CatalogName ', variables('catalogName'), ' -UnityContainerName ', variables('unityContainerName'))]"
        }
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-05-01",
      "name": "[variables('storageAccountName')]",
      "location": "[variables('location')]",
      "sku": { "name": "Standard_LRS" },
      "kind": "StorageV2",
      "properties": {
        "isHnsEnabled": true,
        "accessTier": "Hot",
        "minimumTlsVersion": "TLS1_2",
        "supportsHttpsTrafficOnly": true,
        "allowBlobPublicAccess": false,
        "allowSharedKeyAccess": true
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices",
      "apiVersion": "2023-05-01",
      "name": "[concat(variables('storageAccountName'), '/default')]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-05-01",
      "name": "[concat(variables('storageAccountName'), '/default/', variables('dataContainerName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices', variables('storageAccountName'), 'default')]"
      ],
      "properties": { "publicAccess": "None" }
    },
    {
      "condition": "[parameters('deployDatabricks')]",
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-05-01",
      "name": "[concat(variables('storageAccountName'), '/default/', variables('unityContainerName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices', variables('storageAccountName'), 'default')]"
      ],
      "properties": { "publicAccess": "None" }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[concat('Microsoft.Storage/storageAccounts/', variables('storageAccountName'))]",
      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), parameters('AzureUserObjectId'), variables('roles').storageBlobDataReader)]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('roles').storageBlobDataReader)]",
        "principalId": "[parameters('AzureUserObjectId')]",
        "principalType": "User"
      }
    },
    {
      "type": "Microsoft.Fabric/capacities",
      "apiVersion": "2023-11-01",
      "name": "[variables('capacityName')]",
      "location": "[parameters('fabricLocation')]",
      "sku": {
        "name": "[parameters('fabricCapacitySku')]",
        "tier": "Fabric"
      },
      "properties": {
        "administration": {
          "members": [ "[parameters('AzureUserName')]" ]
        }
      }
    },
    {
      "type": "Microsoft.CognitiveServices/accounts",
      "apiVersion": "2025-06-01",
      "name": "[variables('foundryName')]",
      "location": "[parameters('foundryLocation')]",
      "kind": "AIServices",
      "sku": { "name": "S0" },
      "identity": { "type": "SystemAssigned" },
      "properties": {
        "allowProjectManagement": true,
        "customSubDomainName": "[variables('foundryName')]",
        "publicNetworkAccess": "Enabled",
        "disableLocalAuth": false
      }
    },
    {
      "type": "Microsoft.CognitiveServices/accounts/projects",
      "apiVersion": "2025-06-01",
      "name": "[concat(variables('foundryName'), '/', variables('projectName'))]",
      "location": "[parameters('foundryLocation')]",
      "identity": { "type": "SystemAssigned" },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('foundryName'))]"
      ],
      "properties": {
        "displayName": "[variables('projectName')]",
        "description": "Zava insights project for WRK560"
      }
    },
    {
      "type": "Microsoft.CognitiveServices/accounts/deployments",
      "apiVersion": "2025-06-01",
      "name": "[concat(variables('foundryName'), '/', parameters('modelDeploymentName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts/projects', variables('foundryName'), variables('projectName'))]"
      ],
      "sku": {
        "name": "[parameters('modelSkuName')]",
        "capacity": "[parameters('modelCapacity')]"
      },
      "properties": {
        "model": {
          "format": "OpenAI",
          "name": "[parameters('modelName')]",
          "version": "[parameters('modelVersion')]"
        },
        "versionUpgradeOption": "OnceCurrentVersionExpired"
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[concat('Microsoft.CognitiveServices/accounts/', variables('foundryName'))]",
      "name": "[guid(resourceId('Microsoft.CognitiveServices/accounts', variables('foundryName')), parameters('AzureUserObjectId'), variables('roles').azureAIUser)]",
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('foundryName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('roles').azureAIUser)]",
        "principalId": "[parameters('AzureUserObjectId')]",
        "principalType": "User"
      }
    },
    {
      "condition": "[not(empty(parameters('validationSpObjectId')))]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[concat('Microsoft.CognitiveServices/accounts/', variables('foundryName'))]",
      "name": "[guid(resourceId('Microsoft.CognitiveServices/accounts', variables('foundryName')), 'validator', variables('roles').azureAIUser)]",
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('foundryName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('roles').azureAIUser)]",
        "principalId": "[parameters('validationSpObjectId')]",
        "principalType": "ServicePrincipal"
      }
    },
    {
      "condition": "[parameters('deployDatabricks')]",
      "type": "Microsoft.Databricks/workspaces",
      "apiVersion": "2024-05-01",
      "name": "[variables('databricksName')]",
      "location": "[variables('location')]",
      "sku": { "name": "premium" },
      "properties": {
        "managedResourceGroupId": "[subscriptionResourceId('Microsoft.Resources/resourceGroups', variables('databricksManagedRg'))]"
      }
    },
    {
      "condition": "[parameters('deployDatabricks')]",
      "type": "Microsoft.Databricks/accessConnectors",
      "apiVersion": "2024-05-01",
      "name": "[variables('accessConnectorName')]",
      "location": "[variables('location')]",
      "identity": { "type": "SystemAssigned" },
      "properties": {}
    },
    {
      "condition": "[parameters('deployDatabricks')]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[concat('Microsoft.Storage/storageAccounts/', variables('storageAccountName'))]",
      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), variables('accessConnectorName'), variables('roles').storageBlobDataContributor)]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]",
        "[resourceId('Microsoft.Databricks/accessConnectors', variables('accessConnectorName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('roles').storageBlobDataContributor)]",
        "principalId": "[reference(resourceId('Microsoft.Databricks/accessConnectors', variables('accessConnectorName')), '2024-05-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal"
      }
    },
    {
      "condition": "[parameters('deployDatabricks')]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[concat('Microsoft.Databricks/workspaces/', variables('databricksName'))]",
      "name": "[guid(resourceId('Microsoft.Databricks/workspaces', variables('databricksName')), variables('vmName'), variables('roles').contributor)]",
      "dependsOn": [
        "[resourceId('Microsoft.Databricks/workspaces', variables('databricksName'))]",
        "[resourceId('Microsoft.Compute/virtualMachines', variables('vmName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('roles').contributor)]",
        "principalId": "[reference(resourceId('Microsoft.Compute/virtualMachines', variables('vmName')), '2024-07-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal"
      }
    },
    {
      "condition": "[and(parameters('deployDatabricks'), not(empty(parameters('validationSpObjectId'))))]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[concat('Microsoft.Databricks/workspaces/', variables('databricksName'))]",
      "name": "[guid(resourceId('Microsoft.Databricks/workspaces', variables('databricksName')), 'validator', variables('roles').contributor)]",
      "dependsOn": [
        "[resourceId('Microsoft.Databricks/workspaces', variables('databricksName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('roles').contributor)]",
        "principalId": "[parameters('validationSpObjectId')]",
        "principalType": "ServicePrincipal"
      }
    }
  ],
  "outputs": {
    "LabVM DNS Name": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Network/publicIPAddresses', variables('publicIpAddressName'))).dnsSettings.fqdn]"
    },
    "LabVM Admin Username": {
      "type": "string",
      "value": "[parameters('adminUsername')]"
    },
    "LabVM Admin Password": {
      "type": "string",
      "value": "[parameters('adminPassword')]"
    },
    "TrainerUserName": {
      "type": "string",
      "value": "[parameters('trainerUserName')]"
    },
    "TrainerUserPassword": {
      "type": "string",
      "value": "[parameters('trainerUserPassword')]"
    },
    "DeploymentID": {
      "type": "string",
      "value": "[parameters('DeploymentID')]"
    },
    "Resource Group Name": {
      "type": "string",
      "value": "[resourceGroup().name]"
    },
    "Fabric Capacity Name": {
      "type": "string",
      "value": "[variables('capacityName')]"
    },
    "Fabric Workspace Name": {
      "type": "string",
      "value": "[variables('workspaceName')]"
    },
    "Storage Account Name": {
      "type": "string",
      "value": "[variables('storageAccountName')]"
    },
    "ADLS Gen2 Endpoint": {
      "type": "string",
      "value": "[concat('https://', variables('storageAccountName'), '.dfs.core.windows.net/')]"
    },
    "Foundry Resource Name": {
      "type": "string",
      "value": "[variables('foundryName')]"
    },
    "Foundry Project Name": {
      "type": "string",
      "value": "[variables('projectName')]"
    },
    "Foundry Project Endpoint": {
      "type": "string",
      "value": "[concat('https://', variables('foundryName'), '.services.ai.azure.com/api/projects/', variables('projectName'))]"
    },
    "Model Deployment Name": {
      "type": "string",
      "value": "[parameters('modelDeploymentName')]"
    },
    "Databricks Workspace Name": {
      "condition": "[parameters('deployDatabricks')]",
      "type": "string",
      "value": "[variables('databricksName')]"
    },
    "Databricks Workspace URL": {
      "condition": "[parameters('deployDatabricks')]",
      "type": "string",
      "value": "[concat('https://', reference(resourceId('Microsoft.Databricks/workspaces', variables('databricksName')), '2024-05-01').workspaceUrl)]"
    },
    "Unity Catalog Name": {
      "condition": "[parameters('deployDatabricks')]",
      "type": "string",
      "value": "[variables('catalogName')]"
    }
  }
}
